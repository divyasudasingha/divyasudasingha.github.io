---
// src/pages/about.astro

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Divya" description="A little about Divya Sudasingha.">
  <article class="about-page container">
    <h1>About Divya</h1>
    <p>
      I love creating stories, drawings and fun projects. This is where I share the things I make.
    </p>
  </article>
</BaseLayout>

<style>
  .about-page {
    max-width: 52rem;
    padding-block: clamp(3rem, 10vw, 6rem);
  }

  .about-page h1 {
    margin-bottom: 1rem;
  }

  .about-page p {
    max-width: 40rem;
    color: var(--color-muted);
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    line-height: 1.8;
  }
</style>