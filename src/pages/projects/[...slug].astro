---
// src/pages/projects/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // Same order as the projects page: featured first, then newest.
  // (Everything getStaticPaths needs must live inside it.)
  const projects = (await getCollection('projects')).sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0);
  });

  return projects.map((project, index) => {
    const previous = index > 0 ? projects[index - 1] : undefined;
    const next = index < projects.length - 1 ? projects[index + 1] : undefined;

    return {
      params: { slug: project.id },
      props: {
        project,
        previous: previous ? { id: previous.id, title: previous.data.title } : undefined,
        next: next ? { id: next.id, title: next.data.title } : undefined,
      },
    };
  });
}

const { project, previous, next } = Astro.props;
const { Content } = await render(project);
const baseURL = import.meta.env.BASE_URL;
const projectsURL = `${baseURL}projects/`;

function formatMonth(date?: Date): string | undefined {
  if (!date || Number.isNaN(date.getTime())) return undefined;
  return date.toLocaleDateString('en', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}

const started = formatMonth(project.data.startDate);
const finished = formatMonth(project.data.endDate);
const hasStatus = Boolean(project.data.startDate || project.data.endDate);
const isFinished = Boolean(project.data.endDate);
const { url, repository, technologies } = project.data;
const hasBody = Boolean(project.body?.trim());
---

<BaseLayout title={`${project.data.title} | Divya Sudasingha`} description={project.data.description}>
  <article class="project">
    <header class="project-hero">
      <span class="deco deco-1" aria-hidden="true">🔧</span>
      <span class="deco deco-2" aria-hidden="true">⚡</span>
      <span class="deco deco-3" aria-hidden="true">💡</span>

      <div class="project-hero-inner">
        <a class="back-link" href={projectsURL}>
          <span aria-hidden="true">←</span> All projects
        </a>

        <p class="chip-row">
          <span class="chip chip-mint"><span aria-hidden="true">🧩</span> Project</span>
          {project.data.featured && (
            <span class="chip chip-sun"><span aria-hidden="true">⭐</span> Featured</span>
          )}
          {hasStatus && (
            <span class="chip chip-sky">
              {isFinished ? '✅ Finished' : '🔨 Working on it'}
            </span>
          )}
          {started && (
            <time class="chip chip-white" datetime={project.data.startDate?.toISOString()}>
              <span aria-hidden="true">📅</span> Started {started}
            </time>
          )}
          {finished && started !== finished && (
            <time class="chip chip-white" datetime={project.data.endDate?.toISOString()}>
              <span aria-hidden="true">🏁</span> Finished {finished}
            </time>
          )}
        </p>

        <h1>{project.data.title}</h1>
        <p class="project-lede">{project.data.description}</p>

        {(url || repository) && (
          <p class="project-actions">
            {url && (
              <a class="btn btn-mint" href={url} target="_blank" rel="noopener noreferrer">
                🚀 Try it out
              </a>
            )}
            {repository && (
              <a class="btn btn-sky" href={repository} target="_blank" rel="noopener noreferrer">
                👩‍💻 See the code
              </a>
            )}
          </p>
        )}
      </div>
    </header>

    <div class="project-body">
      {technologies.length > 0 && (
        <section class="made-with" aria-labelledby="made-with-title">
          <h2 id="made-with-title">Made with 🛠️</h2>
          <ul class="tech">
            {technologies.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {hasBody && <div class="prose"><Content /></div>}

      <aside class="more" aria-label="More projects">
        <p class="more-title">Want to see more? 🎉</p>
        <a class="btn btn-mint" href={projectsURL}>🧩 Back to all projects</a>
      </aside>

      {(previous || next) && (
        <nav class="pager" aria-label="Other projects">
          {previous ? (
            <a class="pager-card pager-prev" href={`${baseURL}projects/${previous.id}/`} rel="prev">
              <span class="pager-label"><span aria-hidden="true">←</span> Previous project</span>
              <span class="pager-title">{previous.title}</span>
            </a>
          ) : (
            <span></span>
          )}
          {next ? (
            <a class="pager-card pager-next" href={`${baseURL}projects/${next.id}/`} rel="next">
              <span class="pager-label">Next project <span aria-hidden="true">→</span></span>
              <span class="pager-title">{next.title}</span>
            </a>
          ) : (
            <span></span>
          )}
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  /* ---------- Title band ---------- */
  .project-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem) var(--page-gutter) clamp(2.5rem, 5vw, 3.5rem);
    border-radius: 0 0 2.5rem 2.5rem;
    background:
      radial-gradient(circle at 10% 20%, var(--color-mint-soft) 0, transparent 42%),
      radial-gradient(circle at 92% 12%, var(--color-sky-soft) 0, transparent 45%),
      radial-gradient(circle at 78% 100%, var(--color-sun-soft) 0, transparent 50%),
      var(--color-background);
  }

  .project-hero-inner {
    position: relative;
    z-index: 1;
    width: min(100%, 46rem);
    margin-inline: auto;
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.25rem;
    padding: 0.35rem 1rem;
    align-items: center;
    gap: 0.4rem;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    box-shadow: 0 3px 0 var(--color-ink);
    background: #fff;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .back-link:hover,
  .back-link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--color-ink);
    color: var(--color-ink);
  }

  .chip-row {
    display: flex;
    margin: 0 0 1rem;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    padding: 0.2rem 0.85rem;
    align-items: center;
    gap: 0.35rem;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .chip-mint { background: var(--color-mint-soft); }
  .chip-sun { background: var(--color-sun-soft); }
  .chip-sky { background: var(--color-sky-soft); }
  .chip-white { background: #fff; }

  .project-hero h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(2.4rem, 8vw, 4.25rem);
    line-height: 1.08;
  }

  .project-lede {
    max-width: 36rem;
    margin: 0 auto;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    line-height: 1.55;
  }

  .project-actions {
    display: flex;
    margin: 1.5rem 0 0;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }

  .deco {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    font-size: 2.2rem;
    animation: bob 4s ease-in-out infinite;
  }

  .deco-1 { top: 20%; left: 7%; }
  .deco-2 { top: 12%; right: 8%; animation-delay: -1.5s; }
  .deco-3 { bottom: 20%; right: 14%; font-size: 2.6rem; animation-delay: -2.4s; }

  /* ---------- Body ---------- */
  .project-body {
    width: min(100% - (2 * var(--page-gutter)), 46rem);
    margin-inline: auto;
    padding: 2.5rem 0 4rem;
  }

  .made-with {
    margin-bottom: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius);
    box-shadow: 0 6px 0 var(--color-mint);
    background: #fff;
  }

  .made-with h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 4vw, 1.9rem);
  }

  .tech {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .tech li {
    padding: 0.1rem 0.9rem;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-mint-soft);
    font-weight: 700;
    line-height: 1.7;
  }

  .tech li:nth-child(4n + 2) { background: var(--color-sky-soft); }
  .tech li:nth-child(4n + 3) { background: var(--color-sun-soft); }
  .tech li:nth-child(4n) { background: var(--color-coral-soft); }

  .prose {
    font-size: clamp(1.15rem, 2vw, 1.3rem);
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
  }

  .prose :global(strong) {
    color: var(--color-ink);
  }

  .prose :global(img) {
    height: auto;
    margin-block: 2rem;
    border: 3px solid var(--color-ink);
    border-radius: 1.25rem;
    box-shadow: 0 6px 0 var(--color-sun);
  }

  .prose :global(li::marker) {
    color: var(--color-mint);
    font-weight: 700;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem 1.25rem;
    border: 3px solid var(--color-ink);
    border-radius: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ---------- Footer cards ---------- */
  .more {
    margin-top: 3rem;
    padding: 1.75rem 1.5rem;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius);
    box-shadow: 0 6px 0 var(--color-grape);
    background: var(--color-sun-soft);
    text-align: center;
  }

  .more-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .pager {
    display: grid;
    margin-top: 2rem;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .pager-card {
    display: flex;
    padding: 1rem 1.25rem;
    flex-direction: column;
    gap: 0.15rem;
    border: 3px solid var(--color-ink);
    border-radius: 1.25rem;
    box-shadow: 0 5px 0 var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .pager-prev { background: var(--color-sky-soft); }
  .pager-next { background: var(--color-mint-soft); text-align: right; }

  .pager-card:hover,
  .pager-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 8px 0 var(--color-ink);
    color: var(--color-ink);
  }

  .pager-label {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pager-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .deco-1,
    .deco-3 {
      display: none;
    }

    .pager-next {
      text-align: left;
    }

    .project-actions .btn {
      width: 100%;
    }
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-0.5rem) rotate(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .deco {
      animation: none;
    }

    .back-link,
    .pager-card {
      transition: none;
    }

    .back-link:hover,
    .pager-card:hover {
      transform: none;
    }
  }
</style>
