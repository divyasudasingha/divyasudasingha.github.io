---
// src/pages/projects/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseURL = import.meta.env.BASE_URL;
const projects = (await getCollection('projects'))
  .sort((a, b) => (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0));

function formatDate(date?: Date): string | undefined {
  if (!date || Number.isNaN(date.getTime())) {
    return undefined;
  }

  return new Intl.DateTimeFormat('en', {
    dateStyle: 'medium',
    timeZone: 'UTC',
  }).format(date);
}
---

<BaseLayout title="Projects | Divya Sudasingha" description="Projects by Divya Sudasingha.">
  <section class="listing-page container" aria-labelledby="page-title">
    <h1 id="page-title">Projects</h1>
    {projects.length ? (
      <div class="creation-grid">
        {projects.map((project) => {
          const formattedDate = formatDate(project.data.startDate);

          return (
            <article class="creation-card">
              <div class="card-content card-content-no-image">
                {(formattedDate || 'Project') && (
                  <div class="card-meta">
                    <span>Project</span>
                    {formattedDate && <span aria-hidden="true">·</span>}
                    {formattedDate && <time datetime={project.data.startDate?.toISOString()}>{formattedDate}</time>}
                  </div>
                )}

                <h3>
                  <a class="card-link" href={`${baseURL}projects/${project.id}/`}>{project.data.title}</a>
                </h3>

                {project.data.description && <p class="card-summary">{project.data.description}</p>}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">No projects to share just yet. Check back soon!</p>
    )}
  </section>
</BaseLayout>

<style>
  .listing-page {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .listing-page h1 {
    margin-bottom: 2rem;
  }

  .creation-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .creation-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-background);
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .creation-card:hover,
  .creation-card:focus-within {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .card-content {
    padding: 0.9rem 1rem;
  }

  .card-meta {
    display: flex;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .card-content h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.3;
  }

  .card-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-link:hover {
    color: var(--color-accent);
  }

  .card-summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-content-no-image {
    padding-top: 1.1rem;
  }

  .empty-state {
    color: var(--color-muted);
  }

  @media (min-width: 40rem) {
    .creation-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .creation-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
</style>
