---
import { getCollection } from 'astro:content';
import CreationCard from '../../components/CreationCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0));
---

<BaseLayout title="Projects | Divya Sudasingha" description="Projects by Divya Sudasingha.">
  <section class="listing-page container" aria-labelledby="page-title">
    <h1 id="page-title">Projects</h1>
    {projects.length ? (
      <div class="creation-grid">
        {projects.map((project) => (
          <CreationCard
            title={project.data.title}
            date={project.data.startDate}
            category="Project"
            summary={project.data.description}
            url={`${import.meta.env.BASE_URL}projects/${project.id}/`}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">No projects to share just yet. Check back soon!</p>
    )}
  </section>
</BaseLayout>

<style>
  .listing-page {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .listing-page h1 {
    margin-bottom: 2rem;
  }

  .creation-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .empty-state {
    color: var(--color-muted);
  }

  @media (min-width: 40rem) {
    .creation-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .creation-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
</style>
