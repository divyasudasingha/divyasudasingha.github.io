---
// src/pages/art/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseURL = import.meta.env.BASE_URL;
const art = (await getCollection('art'))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

function withBaseURL(path: string): string {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/|#)/i.test(path)) {
    return path;
  }

  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  const relativePath = path.replace(/^\/+/, '');

  return path.startsWith(base) ? path : `${base}${relativePath}`;
}

function mediumEmoji(medium?: string): string {
  const m = (medium ?? '').toLowerCase();
  if (/crayon|pencil|pastel|chalk/.test(m)) return '🖍️';
  if (/water|paint|acrylic|oil|gouache/.test(m)) return '🖌️';
  if (/marker|pen|ink|sketch/.test(m)) return '🖊️';
  if (/digital|computer|tablet|pixel/.test(m)) return '💻';
  if (/clay|sculpt/.test(m)) return '🏺';
  if (/collage|paper|craft/.test(m)) return '✂️';
  return '🎨';
}

const tones = ['coral', 'grape', 'mint', 'sun'] as const;
const tilts = ['-1.2deg', '0.9deg', '-0.6deg', '1.3deg'];
---

<BaseLayout title="Art | Divya Sudasingha" description="Art by Divya Sudasingha.">
  <section class="page-hero" aria-labelledby="page-title">
    <span class="deco deco-1" aria-hidden="true">🖌️</span>
    <span class="deco deco-2" aria-hidden="true">✨</span>
    <span class="deco deco-3" aria-hidden="true">🌈</span>

    <div class="page-hero-inner">
      <p class="page-emoji" aria-hidden="true">🎨</p>
      <h1 id="page-title">Art</h1>
      <p class="page-lede">Welcome to my picture gallery! Tap a picture to see it up close.</p>
    </div>
  </section>

  <section class="listing container" aria-label="All art">
    {art.length ? (
      <div class="gallery">
        {art.map((piece, index) => {
          const imageURL = piece.data.image ? withBaseURL(piece.data.image) : undefined;
          const tone = tones[index % tones.length];
          const tilt = tilts[index % tilts.length];
          const emoji = mediumEmoji(piece.data.medium);

          return (
            <article class={`frame-card tone-${tone}`} style={`--tilt:${tilt}`}>
              <div class="frame">
                {imageURL ? (
                  <img class="frame-image" src={imageURL} alt="" loading="lazy" />
                ) : (
                  <div class="frame-empty" aria-hidden="true"><span>{emoji}</span></div>
                )}
              </div>

              <div class="caption">
                <h2>
                  <a class="card-link" href={`${baseURL}art/${piece.id}/`}>{piece.data.title}</a>
                </h2>
                <p class="caption-meta">
                  {piece.data.medium && <span class="chip">{emoji} {piece.data.medium}</span>}
                  {piece.data.year && <span class="chip chip-year">📅 {piece.data.year}</span>}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">No art on the wall yet. Check back soon! 🌱</p>
    )}
  </section>
</BaseLayout>

<style>
  /* ---------- Page header ---------- */
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 3.5rem) var(--page-gutter) clamp(2.5rem, 5vw, 3.5rem);
    border-radius: 0 0 2.5rem 2.5rem;
    background:
      radial-gradient(circle at 10% 20%, var(--color-grape-soft) 0, transparent 42%),
      radial-gradient(circle at 92% 15%, var(--color-sun-soft) 0, transparent 45%),
      radial-gradient(circle at 70% 100%, var(--color-mint-soft) 0, transparent 50%),
      var(--color-background);
    text-align: center;
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    margin-inline: auto;
  }

  .page-emoji {
    margin: 0 0 0.25rem;
    font-size: 3rem;
    line-height: 1;
    animation: bob 4s ease-in-out infinite;
  }

  .page-hero h1 {
    margin: 0 0 0.4rem;
    color: var(--color-grape);
    font-size: clamp(3rem, 9vw, 5rem);
    line-height: 1.05;
    text-shadow: 0 4px 0 var(--color-ink);
  }

  .page-lede {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    line-height: 1.5;
  }

  .deco {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    font-size: 2.2rem;
    animation: bob 4s ease-in-out infinite;
  }

  .deco-1 { top: 22%; left: 8%; }
  .deco-2 { top: 14%; right: 9%; animation-delay: -1.5s; }
  .deco-3 { bottom: 16%; right: 20%; font-size: 2.6rem; animation-delay: -2.4s; }

  /* ---------- Gallery wall (pictures keep their own shape) ---------- */
  .listing {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }

  .gallery {
    columns: 1;
    column-gap: 1.75rem;
  }

  .frame-card {
    position: relative;
    display: inline-block;
    width: 100%;
    margin: 0 0 1.75rem;
    break-inside: avoid;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 180ms ease;
  }

  .tone-coral { --accent: var(--color-coral); --accent-soft: var(--color-coral-soft); }
  .tone-grape { --accent: var(--color-grape); --accent-soft: var(--color-grape-soft); }
  .tone-mint { --accent: var(--color-mint); --accent-soft: var(--color-mint-soft); }
  .tone-sun { --accent: var(--color-sun); --accent-soft: var(--color-sun-soft); }

  .frame-card:hover,
  .frame-card:focus-within {
    z-index: 2;
    transform: rotate(0deg) translateY(-6px) scale(1.02);
  }

  .frame-card:focus-within {
    outline: 3px solid var(--color-grape);
    outline-offset: 6px;
    border-radius: var(--radius);
  }

  /* the "picture frame": white mat + chunky outline */
  .frame {
    padding: 0.7rem;
    border: 3px solid var(--color-ink);
    border-radius: 1.25rem;
    box-shadow: 0 7px 0 var(--accent);
    background: #fff;
  }

  .frame-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.7rem;
    background: var(--accent-soft);
  }

  .frame-empty {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    border-radius: 0.7rem;
    background:
      radial-gradient(circle at 22% 28%, #fff 0 0.5rem, transparent 0.55rem),
      radial-gradient(circle at 78% 72%, #fff 0 0.8rem, transparent 0.85rem),
      var(--accent-soft);
  }

  .frame-empty span {
    font-size: 4rem;
  }

  /* name plate under the picture */
  .caption {
    margin: 1rem 0.4rem 0;
    text-align: center;
  }

  .caption h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 1.7rem);
    line-height: 1.2;
  }

  .card-link {
    color: var(--color-ink);
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-link:hover {
    color: var(--color-ink);
  }

  .card-link:focus-visible {
    outline: none;
  }

  .caption-meta {
    display: flex;
    margin: 0.5rem 0 0;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .chip {
    padding: 0.1rem 0.75rem;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .chip-year {
    background: #fff;
  }

  .empty-state {
    color: var(--color-muted);
    font-size: 1.15rem;
    text-align: center;
  }

  @media (min-width: 40rem) {
    .gallery {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .gallery {
      columns: 3;
      column-gap: 2.25rem;
    }
  }

  @media (max-width: 39.99rem) {
    .deco-1,
    .deco-3 {
      display: none;
    }
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-0.5rem) rotate(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .deco,
    .page-emoji {
      animation: none;
    }

    .frame-card {
      transition: none;
      transform: none;
    }

    .frame-card:hover,
    .frame-card:focus-within {
      transform: none;
    }
  }
</style>
