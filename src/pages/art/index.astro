---
// src/pages/art/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseURL = import.meta.env.BASE_URL;
const art = (await getCollection('art'))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

function withBaseURL(path: string): string {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/|#)/i.test(path)) {
    return path;
  }

  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  const relativePath = path.replace(/^\/+/, '');

  return path.startsWith(base) ? path : `${base}${relativePath}`;
}

function formatDate(date?: Date): string | undefined {
  if (!date || Number.isNaN(date.getTime())) {
    return undefined;
  }

  return new Intl.DateTimeFormat('en', {
    dateStyle: 'medium',
    timeZone: 'UTC',
  }).format(date);
}
---

<BaseLayout title="Art | Divya Sudasingha" description="Art by Divya Sudasingha.">
  <section class="listing-page container" aria-labelledby="page-title">
    <h1 id="page-title">Art</h1>
    {art.length ? (
      <div class="creation-grid">
        {art.map((piece) => {
          const imageURL = piece.data.image ? withBaseURL(piece.data.image) : undefined;
          const pieceDate = piece.data.year ? new Date(Date.UTC(piece.data.year, 0, 1)) : undefined;
          const formattedDate = formatDate(pieceDate);

          return (
            <article class="creation-card">
              {imageURL ? <img class="card-image" src={imageURL} alt="" loading="lazy" /> : null}

              <div class:list={['card-content', { 'card-content-no-image': !imageURL }]}>
                {(formattedDate || 'Art') && (
                  <div class="card-meta">
                    <span>Art</span>
                    {formattedDate && <span aria-hidden="true">·</span>}
                    {formattedDate && <time datetime={pieceDate?.toISOString()}>{formattedDate}</time>}
                  </div>
                )}

                <h3>
                  <a class="card-link" href={`${baseURL}art/${piece.id}/`}>{piece.data.title}</a>
                </h3>

                {piece.data.description && <p class="card-summary">{piece.data.description}</p>}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">No art to share just yet. Check back soon!</p>
    )}
  </section>
</BaseLayout>

<style>
  .listing-page {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .listing-page h1 {
    margin-bottom: 2rem;
  }

  .creation-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .creation-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-background);
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .creation-card:hover,
  .creation-card:focus-within {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .card-content {
    padding: 0.9rem 1rem;
  }

  .card-meta {
    display: flex;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .card-content h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.3;
  }

  .card-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-link:hover {
    color: var(--color-accent);
  }

  .card-summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-content-no-image {
    padding-top: 1.1rem;
  }

  .empty-state {
    color: var(--color-muted);
  }

  @media (min-width: 40rem) {
    .creation-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .creation-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
</style>
