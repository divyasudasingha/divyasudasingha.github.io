---
// src/pages/art/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // Same order as the gallery: newest year first
  const art = (await getCollection('art'))
    .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

  return art.map((piece, index) => {
    const newer = index > 0 ? art[index - 1] : undefined;
    const older = index < art.length - 1 ? art[index + 1] : undefined;

    return {
      params: { slug: piece.id },
      props: {
        piece,
        newer: newer ? { id: newer.id, title: newer.data.title } : undefined,
        older: older ? { id: older.id, title: older.data.title } : undefined,
      },
    };
  });
}

const { piece, newer, older } = Astro.props;
const { Content } = await render(piece);
const baseURL = import.meta.env.BASE_URL;

function withBaseURL(path: string): string {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(path)) return path;
  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  return path.startsWith(base) ? path : `${base}${path.replace(/^\/+/, '')}`;
}

function mediumEmoji(medium?: string): string {
  const m = (medium ?? '').toLowerCase();
  if (/crayon|pencil|pastel|chalk/.test(m)) return '🖍️';
  if (/water|paint|acrylic|oil|gouache/.test(m)) return '🖌️';
  if (/marker|pen|ink|sketch/.test(m)) return '🖊️';
  if (/digital|computer|tablet|pixel/.test(m)) return '💻';
  if (/clay|sculpt/.test(m)) return '🏺';
  if (/collage|paper|craft/.test(m)) return '✂️';
  return '🎨';
}

const imageURL = piece.data.image ? withBaseURL(piece.data.image) : undefined;
const emoji = mediumEmoji(piece.data.medium);
const artURL = `${baseURL}art/`;

// If the text already contains the same picture as the frontmatter `image`,
// hide the copy inside the text so the picture only shows once.
const imageFile = piece.data.image?.split('/').pop()?.split('?')[0];
const bodyRepeatsImage = Boolean(imageFile && piece.body?.includes(imageFile));
const safeImageFile = imageFile?.replace(/["\\]/g, '\\$&');
const hideDuplicateCSS = bodyRepeatsImage
  ? `.prose p:has(> img[src*="${safeImageFile}"]:only-child),
     .prose img[src*="${safeImageFile}"] { display: none; }`
  : '';

const hasBody = Boolean(piece.body?.trim()) && !(bodyRepeatsImage && piece.body!.replace(/!\[[^\]]*\]\([^)]*\)/g, '').trim() === '');
---

<BaseLayout title={`${piece.data.title} | Divya Sudasingha`} description={piece.data.description}>
  <article class="art">
    <header class="art-hero">
      <span class="deco deco-1" aria-hidden="true">🖌️</span>
      <span class="deco deco-2" aria-hidden="true">✨</span>
      <span class="deco deco-3" aria-hidden="true">🌈</span>

      <div class="art-hero-inner">
        <a class="back-link" href={artURL}>
          <span aria-hidden="true">←</span> All art
        </a>

        <p class="chip-row">
          <span class="chip chip-grape"><span aria-hidden="true">🎨</span> Art</span>
          {piece.data.medium && (
            <span class="chip chip-sun"><span aria-hidden="true">{emoji}</span> {piece.data.medium}</span>
          )}
          {piece.data.year && (
            <time class="chip chip-sky" datetime={`${piece.data.year}`}>
              <span aria-hidden="true">📅</span> {piece.data.year}
            </time>
          )}
        </p>

        <h1>{piece.data.title}</h1>
        {piece.data.description && <p class="art-lede">{piece.data.description}</p>}
      </div>
    </header>

    <div class="art-body">
      {imageURL && (
        <figure class="art-figure">
          <div class="art-frame">
            <img src={imageURL} alt={`Artwork: ${piece.data.title}`} />
          </div>
          <figcaption>
            <a class="btn btn-sun" href={imageURL} target="_blank" rel="noopener">🔍 See it full size</a>
          </figcaption>
        </figure>
      )}

      {hideDuplicateCSS && <Fragment set:html={`<style>${hideDuplicateCSS}</style>`} />}
      {hasBody && <div class="prose"><Content /></div>}

      <aside class="more-art" aria-label="More art">
        <p class="more-art-title">Want to see more? 🎉</p>
        <a class="btn btn-grape" href={artURL}>🎨 Back to the gallery</a>
      </aside>

      {(newer || older) && (
        <nav class="pager" aria-label="Other pictures">
          {newer ? (
            <a class="pager-card pager-newer" href={`${baseURL}art/${newer.id}/`} rel="prev">
              <span class="pager-label"><span aria-hidden="true">←</span> Newer picture</span>
              <span class="pager-title">{newer.title}</span>
            </a>
          ) : (
            <span></span>
          )}
          {older ? (
            <a class="pager-card pager-older" href={`${baseURL}art/${older.id}/`} rel="next">
              <span class="pager-label">Older picture <span aria-hidden="true">→</span></span>
              <span class="pager-title">{older.title}</span>
            </a>
          ) : (
            <span></span>
          )}
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  /* ---------- Title band ---------- */
  .art-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem) var(--page-gutter) clamp(2.5rem, 5vw, 3.5rem);
    border-radius: 0 0 2.5rem 2.5rem;
    background:
      radial-gradient(circle at 10% 20%, var(--color-grape-soft) 0, transparent 42%),
      radial-gradient(circle at 92% 12%, var(--color-sun-soft) 0, transparent 45%),
      radial-gradient(circle at 78% 100%, var(--color-mint-soft) 0, transparent 50%),
      var(--color-background);
  }

  .art-hero-inner {
    position: relative;
    z-index: 1;
    width: min(100%, 46rem);
    margin-inline: auto;
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.25rem;
    padding: 0.35rem 1rem;
    align-items: center;
    gap: 0.4rem;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    box-shadow: 0 3px 0 var(--color-ink);
    background: #fff;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .back-link:hover,
  .back-link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--color-ink);
    color: var(--color-ink);
  }

  .chip-row {
    display: flex;
    margin: 0 0 1rem;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    padding: 0.2rem 0.85rem;
    align-items: center;
    gap: 0.35rem;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .chip-grape { background: var(--color-grape-soft); }
  .chip-sun { background: var(--color-sun-soft); }
  .chip-sky { background: var(--color-sky-soft); }

  .art-hero h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(2.4rem, 8vw, 4.25rem);
    line-height: 1.08;
  }

  .art-lede {
    max-width: 36rem;
    margin: 0 auto;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    line-height: 1.55;
  }

  .deco {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    font-size: 2.2rem;
    animation: bob 4s ease-in-out infinite;
  }

  .deco-1 { top: 20%; left: 7%; }
  .deco-2 { top: 12%; right: 8%; animation-delay: -1.5s; }
  .deco-3 { bottom: 20%; right: 14%; font-size: 2.6rem; animation-delay: -2.4s; }

  /* ---------- Body ---------- */
  .art-body {
    width: min(100% - (2 * var(--page-gutter)), 56rem);
    margin-inline: auto;
    padding: 2rem 0 4rem;
  }

  .art-figure {
    margin: 0 0 2.5rem;
    text-align: center;
  }

  /* picture is shown whole (never cropped) inside a frame */
  .art-frame {
    display: inline-block;
    max-width: 100%;
    padding: clamp(0.6rem, 2vw, 1rem);
    border: 4px solid var(--color-ink);
    border-radius: var(--radius);
    box-shadow: 0 9px 0 var(--color-grape);
    background: #fff;
    transform: rotate(-0.6deg);
  }

  .art-frame img {
    width: auto;
    max-width: 100%;
    max-height: min(75vh, 44rem);
    border-radius: 1rem;
    object-fit: contain;
  }

  .art-figure figcaption {
    margin-top: 1.6rem;
  }

  .prose {
    max-width: 44rem;
    margin-inline: auto;
    font-size: clamp(1.15rem, 2vw, 1.3rem);
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
  }

  .prose :global(img) {
    height: auto;
    margin-block: 1.5rem;
    border: 3px solid var(--color-ink);
    border-radius: 1.25rem;
    box-shadow: 0 6px 0 var(--color-sun);
  }

  /* ---------- Footer cards ---------- */
  .more-art {
    margin-top: 3rem;
    padding: 1.75rem 1.5rem;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius);
    box-shadow: 0 6px 0 var(--color-coral);
    background: var(--color-sun-soft);
    text-align: center;
  }

  .more-art-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .pager {
    display: grid;
    margin-top: 2rem;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .pager-card {
    display: flex;
    padding: 1rem 1.25rem;
    flex-direction: column;
    gap: 0.15rem;
    border: 3px solid var(--color-ink);
    border-radius: 1.25rem;
    box-shadow: 0 5px 0 var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .pager-newer { background: var(--color-mint-soft); }
  .pager-older { background: var(--color-sky-soft); text-align: right; }

  .pager-card:hover,
  .pager-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 8px 0 var(--color-ink);
    color: var(--color-ink);
  }

  .pager-label {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pager-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .deco-1,
    .deco-3 {
      display: none;
    }

    .pager-older {
      text-align: left;
    }
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-0.5rem) rotate(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .deco {
      animation: none;
    }

    .back-link,
    .pager-card {
      transition: none;
    }

    .back-link:hover,
    .pager-card:hover {
      transform: none;
    }

    .art-frame {
      transform: none;
    }
  }
</style>
