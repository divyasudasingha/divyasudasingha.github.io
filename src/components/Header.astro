---
const baseURL = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname
  .slice(baseURL.length)
  .replace(/^\/|\/$/g, '');

const navigation = [
  { label: 'Stories', path: 'stories' },
  { label: 'Art', path: 'art' },
  { label: 'Projects', path: 'projects' },
  { label: 'About', path: 'about' },
];
---

<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="header-inner">
    <a class="brand" href={baseURL}>Divya Sudasingha</a>
    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {navigation.map(({ label, path }) => {
          const isCurrent = currentPath === path || currentPath.startsWith(`${path}/`);

          return (
            <li>
              <a
                class:list={['nav-link', { 'is-current': isCurrent }]}
                href={`${baseURL}${path}/`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    width: min(100% - (2 * var(--page-gutter)), var(--content-width));
    min-height: 4.25rem;
    margin-inline: auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding-block: 0.75rem;
  }

  .brand {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-list {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.75rem;
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding: 0.25rem 0.2rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav-link:hover,
  .nav-link.is-current {
    color: var(--color-accent);
  }

  .nav-link.is-current {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .skip-link {
    position: absolute;
    z-index: 1;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.5rem 0.75rem;
    transform: translateY(-150%);
    background: var(--color-background);
    color: var(--color-text);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (min-width: 42rem) {
    .header-inner {
      min-height: 4.5rem;
      flex-direction: row;
      justify-content: space-between;
      gap: 1.5rem;
      padding-block: 0;
    }

    .nav-list {
      gap: 0.75rem 1.25rem;
    }
  }
</style>
