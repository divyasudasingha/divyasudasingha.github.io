---
interface Props {
  title: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, actionLabel, actionHref } = Astro.props;
const baseURL = import.meta.env.BASE_URL;

function withBaseURL(path: string): string {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/|#)/i.test(path)) return path;
  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  const relativePath = path.replace(/^\/+/, '');
  return path.startsWith(base) ? path : `${base}${relativePath}`;
}

const actionURL = actionHref ? withBaseURL(actionHref) : undefined;
---

<div class="section-heading">
  <h2>{title}</h2>
  {actionLabel && actionURL && <a href={actionURL}>{actionLabel}</a>}
</div>

<style>
  .section-heading {
    display: flex;
    margin-bottom: 1.5rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .section-heading h2 {
    margin: 0;
  }

  .section-heading a {
    font-weight: 700;
    white-space: nowrap;
  }

  @media (min-width: 36rem) {
    .section-heading {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>
