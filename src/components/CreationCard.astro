---
interface Props {
  title: string;
  date?: Date | string;
  category?: string;
  image?: string;
  imageAlt?: string;
  summary?: string;
  url?: string;
}

const { title, date, category, image, imageAlt = '', summary, url } = Astro.props;
const baseURL = import.meta.env.BASE_URL;

function withBaseURL(path: string): string {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/|#)/i.test(path)) return path;
  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  const relativePath = path.replace(/^\/+/, '');
  return path.startsWith(base) ? path : `${base}${relativePath}`;
}

const imageURL = image ? withBaseURL(image) : undefined;
const cardURL = url ? withBaseURL(url) : undefined;
const parsedDate = date ? new Date(date) : undefined;
const validDate = parsedDate && !Number.isNaN(parsedDate.getTime()) ? parsedDate : undefined;
const formattedDate = validDate
  ? new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(validDate)
  : undefined;
---

<article class="creation-card">
  {imageURL ? (
    <img class="card-image" src={imageURL} alt={imageAlt} loading="lazy" />
  ) : (
    <div class="card-image card-image-empty" aria-hidden="true"></div>
  )}
  <div class="card-content">
    {(category || formattedDate) && (
      <div class="card-meta">
        {category && <span>{category}</span>}
        {category && formattedDate && <span aria-hidden="true">·</span>}
        {formattedDate && <time datetime={validDate?.toISOString()}>{formattedDate}</time>}
      </div>
    )}
    <h3>{cardURL ? <a class="card-link" href={cardURL}>{title}</a> : title}</h3>
    {summary && <p class="card-summary">{summary}</p>}
  </div>
</article>

<style>
  .creation-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-background);
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .creation-card:hover,
  .creation-card:focus-within {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card-image-empty {
    background: var(--color-border);
  }

  .card-content {
    padding: 1.25rem;
  }

  .card-meta {
    display: flex;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .card-content h3 {
    margin-bottom: 0.5rem;
    font-size: clamp(1.375rem, 5vw, 1.75rem);
  }

  .card-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .card-link:hover {
    color: var(--color-accent);
  }

  .card-link:focus-visible {
    border-radius: 0.1rem;
  }

  .card-summary {
    margin: 0;
    color: var(--color-muted);
  }
</style>
