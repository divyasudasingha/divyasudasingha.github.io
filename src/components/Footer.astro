---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="footer-name">Divya Sudasingha</p>
  <p class="footer-note">Made with Dad <span aria-label="love" role="img">♥</span> · © {year}</p>
</footer>

<style>
  .site-footer {
    padding: 1.75rem var(--page-gutter);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer-name {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .footer-note {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .footer-note span {
    color: var(--color-accent);
  }
</style>
