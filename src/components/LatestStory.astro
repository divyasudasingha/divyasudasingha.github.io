---
import { getCollection } from 'astro:content';

const baseURL = import.meta.env.BASE_URL;
const stories = (await getCollection('stories', ({ data }) => !data.draft))
  .filter((story) => story.data.pubDate)
  .sort((a, b) => b.data.pubDate!.getTime() - a.data.pubDate!.getTime());
const latestStory = stories[0];

function withBaseURL(path: string): string {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/|#)/i.test(path)) return path;
  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  const relativePath = path.replace(/^\/+/, '');
  return path.startsWith(base) ? path : `${base}${relativePath}`;
}

const storySummary = latestStory?.data.description
  ?? latestStory?.body.replace(/[#*_`>\[\]()!-]/g, ' ').replace(/\s+/g, ' ').trim();
const imageURL = latestStory?.data.image
  ? withBaseURL(latestStory.data.image)
  : undefined;
const storyURL = latestStory ? withBaseURL(`stories/${latestStory.id}/`) : undefined;
---

{latestStory && (
  <section class="latest-story" aria-labelledby="latest-story-title">
    <div class="latest-story-inner">
      <p class="eyebrow">Latest story</p>
      <a class="story-feature" href={storyURL}>
        {imageURL ? (
          <img
            class="story-image"
            src={imageURL}
            alt=""
            loading="lazy"
          />
        ) : (
          <div class="story-image story-image-empty" aria-hidden="true"></div>
        )}
        <div class="story-copy">
          <h2 id="latest-story-title">{latestStory.data.title}</h2>
          {storySummary && <p>{storySummary}</p>}
          <span class="story-read-link">Read the story <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>
  </section>
)}

<style>
  .latest-story {
    padding: 1rem var(--page-gutter) 4rem;
  }

  .latest-story-inner {
    width: min(100%, var(--content-width));
    margin-inline: auto;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .story-feature {
    display: grid;
    overflow: hidden;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .story-feature:hover,
  .story-feature:focus-visible {
    border-color: var(--color-accent);
  }

  .story-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .story-image-empty {
    background: var(--color-border);
  }

  .story-copy {
    padding: 1.5rem;
  }

  .story-copy h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 6vw, 2.5rem);
  }

  .story-copy > p {
    color: var(--color-muted);
  }

  .story-read-link {
    color: var(--color-accent);
    font-weight: 700;
  }

  @media (min-width: 44rem) {
    .latest-story {
      padding-top: 2rem;
      padding-bottom: 5rem;
    }

    .story-feature {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: stretch;
    }

    .story-image {
      height: 100%;
      min-height: 17rem;
      aspect-ratio: auto;
    }

    .story-copy {
      display: flex;
      padding: clamp(1.5rem, 4vw, 3rem);
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
    }
  }
</style>
